# Copy this file to ".env" and fill in real values. ".env" itself is gitignored.
# On Streamlit Community Cloud, set these under App settings > Secrets instead
# of committing a .env file.

# Basketbal Vlaanderen club GUID (found in Thuismatchen.ipynb — BBC Haantjes Certifisc Oudenaarde)
VBL_CLUB_GUID=BVBL1037
VBL_OWN_TEAM_PREFIX=BBC Haantjes

# Path to the Twizzit "Beheer agenda > Wedstrijden" CSV export (local dev only —
# once deployed, use the in-app upload widget instead since there's no local disk).
TWIZZIT_CSV_PATH=data/twizzit_export.csv

# Postgres connection string for shared referee-assignment storage (e.g. a free
# Supabase project: Project Settings > Database > Connection string > URI).
# Leave empty for local development — falls back to a local SQLite file.
DATABASE_URL=
