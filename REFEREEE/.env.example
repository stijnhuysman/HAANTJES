# Copy this file to ".env" and fill in real values. ".env" itself is gitignored.
# On Streamlit Community Cloud, set these under App settings > Secrets instead
# of committing a .env file.

# Basketbal Vlaanderen club GUID (found in Thuismatchen.ipynb — BBC Haantjes Certifisc Oudenaarde)
VBL_CLUB_GUID=BVBL1037
VBL_OWN_TEAM_PREFIX=BBC Haantjes

# Team codes (exact ownTeamCode, e.g. "J16 B") that should never show "toewijzing
# verwacht via BVBL" / wait for Basketbal Vlaanderen's own official, regardless of
# age tier — the club self-assigns for these from day one. Comma-separated.
BBVL_EXCLUDED_TEAMS=J16 B,J18 B

# Path to the Twizzit "Beheer agenda > Wedstrijden" CSV export (local dev only —
# once deployed, use the in-app upload widget instead since there's no local disk).
TWIZZIT_CSV_PATH=data/twizzit_export.csv

# Postgres connection string for shared referee-assignment storage (e.g. a free
# Supabase project: Project Settings > Database > Connection string > URI).
# Leave empty for local development — falls back to a local SQLite file.
DATABASE_URL=

# Admin-override password (the small "A" button on each match card). Leave empty
# to use the hardcoded fallback in src/match_view.py — but since this repo is
# public, that fallback is readable by anyone. Set a real value here for local
# dev, and set it again under the Streamlit Cloud app's Secrets for production —
# they don't have to match, and the deployed one should NOT be the public fallback.
ADMIN_PASSWORD=

# Second admin password: logs in as "admin-hiërarchie" — same admin view, but
# referees can only be added by picking from the players the ref hierarchy allows
# for that match (and who are free at that time). Leave empty to use the public
# fallback in src/match_view.py ("1111"); set a real value in Streamlit Secrets.
ADMIN_PASSWORD_2=
