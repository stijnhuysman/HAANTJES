  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def toon_uitgebreid_verslag(wedguid: str, save_html_file: bool = False):\n",
    "    \"\"\"Bouwt het officile VBL wedstrijdblad (zoals op Matchdetailpdf) op in HTML.\"\"\"\n",
    "    # 1. Match info\n",
    "    r_m = requests.get(f\"{VBL_BASE_URL}/MatchByWedGuid[X]issguid={wedguid}\", headers=API_HEADERS, timeout=10)\n",
    "    if r_m.status_code != 200 or not r_m.text:\n",
    "        print(f\"Wedstrijd {wedguid} niet gevonden.\")\n",
    "        return\n",
    "    m = r_m.json()[0]\n",
    "\n",
    "    # 2. Deelnemers, Voortgang en Officials\n",
    "    p_load = {\"AuthHeader\": VBL_AUTH_HEADER, \"WQVer\": \"nov2\", \"WedGUID\": wedguid, \"CRUD\": \"R\"}\n",
    "    r_deel = requests.put(f\"{VBL_BASE_URL}/DwfDeelByWedGuid\", headers=API_HEADERS, json=p_load, timeout=10)\n",
    "    r_vgng = requests.put(f\"{VBL_BASE_URL}/DwfVgngByWedGuid\", headers=API_HEADERS, json=p_load, timeout=10)\n",
    "    r_offi = requests.put(f\"{VBL_BASE_URL}/DwfOffiByWedGuid\", headers=API_HEADERS, json=p_load, timeout=10)\n",
    "\n",
    "    d_deel = r_deel.json() if r_deel.status_code == 200 and r_deel.text else {}\n",
    "    d_vgng = r_vgng.json() if r_vgng.status_code == 200 and r_vgng.text else {}\n",
    "    d_offi = r_offi.json() if r_offi.status_code == 200 and r_offi.text else {}\n",
    "\n",
    "    if not d_vgng or not d_vgng.get(\"GebNis\"):\n",
    "        print(f\" Geen DWF wedstrijdverloop beschikbaar voor {wedguid}.\")\n",
    "        return\n",
    "\n",
    "    tt_players = {p[\"RelGUID\"]: p for p in (d_deel.get(\"TtDeel\") or []) if isinstance(p, dict)}\n",
    "    tu_players = {p[\"RelGUID\"]: p for p in (d_deel.get(\"TuDeel\") or []) if isinstance(p, dict)}\n",
    "\n",
    "    for p in list(tt_players.values()) + list(tu_players.values()):\n",
    "        p[\"score\"] = 0\n",
    "        p[\"sFouten\"] = []\n",
    "\n",
    "    period_totals = {\n",
    "        1: {\"T\": 0, \"U\": 0, \"T_f\": 0, \"U_f\": 0, \"T_to\": 0, \"U_to\": 0},\n",
    "        2: {\"T\": 0, \"U\": 0, \"T_f\": 0, \"U_f\": 0, \"T_to\": 0, \"U_to\": 0},\n",
    "        3: {\"T\": 0, \"U\": 0, \"T_f\": 0, \"U_f\": 0, \"T_to\": 0, \"U_to\": 0},\n",
    "        4: {\"T\": 0, \"U\": 0, \"T_f\": 0, \"U_f\": 0, \"T_to\": 0, \"U_to\": 0},\n",
    "    }\n",
    "\n",
    "    for g in (d_vgng.get(\"GebNis\") or []):\n",
    "        if not isinstance(g, dict): continue\n",
    "        g_type = g.get(\"GebType\")\n",
    "        rel = g.get(\"RelGUID\")\n",
    "        tofu = g.get(\"TofU\")\n",
    "        per = g.get(\"Periode\", 1)\n",
    "        if per == 99: continue\n",
    "        if per not in period_totals:\n",
    "            period_totals[per] = {\"T\": 0, \"U\": 0, \"T_f\": 0, \"U_f\": 0, \"T_to\": 0, \"U_to\": 0}\n",
    "\n",
    "        if g_type == 10:  # Score\n",
    "            txt = str(g.get(\"Text\", \"\"))\n",
    "            pts = int(txt[0]) if txt and txt[0].isdigit() else 0\n",
    "            if tofu == \"T\":\n",
    "                if rel in tt_players: tt_players[rel][\"score\"] += pts\n",
    "                period_totals[per][\"T\"] += pts\n",
    "            elif tofu == \"U\":\n",
    "                if rel in tu_players: tu_players[rel][\"score\"] += pts\n",
    "                period_totals[per][\"U\"] += pts\n",
    "        elif g_type == 20:  # Timeout\n",
    "            if tofu == \"T\": period_totals[per][\"T_to\"] += 1\n",
    "            elif tofu == \"U\": period_totals[per][\"U_to\"] += 1\n",
    "        elif g_type == 30:  # Fout\n",
    "            f_code = str(g.get(\"Text\", \"\")).strip(\"()\")\n",
    "            if tofu == \"T\":\n",
    "                if rel in tt_players: tt_players[rel][\"sFouten\"].append(f_code)\n",
    "                period_totals[per][\"T_f\"] += 1\n",
    "            elif tofu == \"U\":\n",
    "                if rel in tu_players: tu_players[rel][\"sFouten\"].append(f_code)\n",
    "                period_totals[per][\"U_f\"] += 1\n",
    "\n",
    "    period_rows = \"\"\n",
    "    for per in sorted(period_totals.keys()):\n",
    "        p_data = period_totals[per]\n",
    "        period_rows += f\"\"\"<tr style='border-bottom:1px solid #ddd;'>\n",
    "            <td style='font-weight:bold; padding:4px;'>Q{per}</td>\n",
    "            <td style='text-align:center;'>{p_data['T']} - {p_data['U']}</td>\n",
    "            <td style='text-align:center;'>{p_data['T_f']}</td>\n",
    "            <td style='text-align:center;'>{p_data['U_f']}</td>\n",
    "            <td style='text-align:center;'>{p_data['T_to']}</td>\n",
    "            <td style='text-align:center;'>{p_data['U_to']}</td>\n",
    "        </tr>\"\"\"\n",
    "\n",
    "    def render_team_rows(players_dict):\n",
    "        rows = \"\"\n",
    "        for p in players_dict.values():\n",
    "            if p.get(\"Functie\") != \"S\": continue\n",
    "            f = p[\"sFouten\"] + [\"\"] * (5 - len(p[\"sFouten\"]))\n",
    "            gd = \"GD\" if len(p[\"sFouten\"]) >= 5 else \"\"\n",
    "            r1 = \"\" if p.get(\"Rol1e5\") == \"Y\" else \"\"\n",
    "            \n",
    "            f_cells = \"\"\n",
    "            for code in f[:5]:\n",
    "                is_special = any(code.startswith(k) for k in [\"T\", \"U\", \"D\", \"FL\", \"C\", \"B\"])\n",
    "                bg = \"#ffcdd2\" if is_special else (\"#fffde7\" if code else \"#fafafa\")\n",
    "                f_cells += f\"<td style='text-align:center; background:{bg}; font-weight:bold; padding:4px; border:1px solid #e0e0e0;'>{code}</td>\"\n",
    "                \n",
    "            rows += f\"\"\"<tr style='border-bottom:1px solid #eee;'>\n",
    "                <td style='font-weight:bold; text-align:center; padding:4px;'>{p.get('RugNr', '')}</td>\n",
    "                <td style='padding:4px;'>{p.get('Naam', '')}</td>\n",
    "                <td style='text-align:center; color:#ff9800;'>{r1}</td>\n",
    "                {f_cells}\n",
    "                <td style='text-align:center; color:red; font-weight:bold;'>{gd}</td>\n",
    "                <td style='text-align:center; font-weight:bold; background:#e8f5e9;'>{p['score']}</td>\n",
    "            </tr>\"\"\"\n",
    "        return rows\n",
    "\n",
    "    off_items = \"\".join([\n",
    "        f\"<li><b>{o.get('Functie', 'Official')}:</b> {o.get('Naam', '')}</li>\"\n",
    "        for o in (d_offi.get(\"Offs\") or []) if isinstance(o, dict) and o.get(\"Naam\")\n",
    "    ])\n",
    "\n",
    "    html = f\"\"\"\n",
    "    <div style='font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif; max-width:880px; margin:1rem auto; padding:1.5rem; border:1px solid #cdd5df; border-radius:10px; background:white; box-shadow:0 3px 10px rgba(0,0,0,0.08);'>\n",
    "        <div style='display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #10243e; padding-bottom:0.75rem; margin-bottom:1rem;'>\n",
    "            <div>\n",
    "                <h2 style='margin:0; color:#10243e; font-size:1.3rem;'> {m['teamThuisNaam']} vs {m['teamUitNaam']}</h2>\n",
    "                <div style='color:#666; font-size:0.85rem; margin-top:4px;'> {m['pouleNaam']}   {m['datumString']}   {m.get('accommodatieDoc', {}).get('naam', '')}</div>\n",
    "            </div>\n",
    "            <div style='text-align:right;'>\n",
    "                <div style='font-size:1.8rem; font-weight:bold; color:#d62728;'>{m.get('uitslag', '')}</div>\n",
    "                <div style='font-size:0.75rem; color:#888;'>WedID: {m.get('wedID', '')}</div>\n",
    "            </div>\n",
    "        </div>\n",
    "\n",
    "        <div style='display:flex; gap:1.5rem; margin-bottom:1.5rem;'>\n",
    "            <div style='flex:1;'>\n",
    "                <h4 style='margin:0 0 0.4rem 0; color:#10243e; font-size:0.95rem;'> Kwartstanden</h4>\n",
    "                <table style='width:100%; border-collapse:collapse; font-size:0.82rem;'>\n",
    "                    <thead><tr style='background:#f0f3f7;'><th style='padding:4px;'>Q</th><th>Score</th><th>F (Thuis)</th><th>F (Uit)</th><th>TO (T)</th><th>TO (U)</th></tr></thead>\n",
    "                    <tbody>{period_rows}</tbody>\n",
    "                </table>\n",
    "            </div>\n",
    "            <div style='flex:1;'>\n",
    "                <h4 style='margin:0 0 0.4rem 0; color:#10243e; font-size:0.95rem;'> Officials & Tafelaars</h4>\n",
    "                <ul style='font-size:0.82rem; line-height:1.6; margin:0; padding-left:1.2rem;'>{off_items}</ul>\n",
    "            </div>\n",
    "        </div>\n",
    "\n",
    "        <h4 style='color:#10243e; margin:0.8rem 0 0.3rem 0; font-size:1rem;'> Thuisploeg: {m['teamThuisNaam']}</h4>\n",
    "        <table style='width:100%; border-collapse:collapse; margin-bottom:1.2rem; font-size:0.85rem;'>\n",
    "            <thead><tr style='background:#10243e; color:white;'><th style='width:35px;'>Nr</th><th style='text-align:left; padding:4px;'>Speler</th><th style='width:30px;'>1e5</th><th style='width:40px;'>F1</th><th style='width:40px;'>F2</th><th style='width:40px;'>F3</th><th style='width:40px;'>F4</th><th style='width:40px;'>F5</th><th style='width:40px;'>Uitsl</th><th style='width:50px;'>Score</th></tr></thead>\n",
    "            <tbody>{render_team_rows(tt_players)}</tbody>\n",
    "        </table>\n",
    "\n",
    "        <h4 style='color:#10243e; margin:0.8rem 0 0.3rem 0; font-size:1rem;'> Uitploeg: {m['teamUitNaam']}</h4>\n",
    "        <table style='width:100%; border-collapse:collapse; margin-bottom:0.5rem; font-size:0.85rem;'>\n",
    "            <thead><tr style='background:#10243e; color:white;'><th style='width:35px;'>Nr</th><th style='text-align:left; padding:4px;'>Speler</th><th style='width:30px;'>1e5</th><th style='width:40px;'>F1</th><th style='width:40px;'>F2</th><th style='width:40px;'>F3</th><th style='width:40px;'>F4</th><th style='width:40px;'>F5</th><th style='width:40px;'>Uitsl</th><th style='width:50px;'>Score</th></tr></thead>\n",
    "            <tbody>{render_team_rows(tu_players)}</tbody>\n",
    "        </table>\n",
    "    </div>\n",
